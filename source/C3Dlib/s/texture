
	GET C3Dlib:hdr.defs

	GET C3Dlib:s.texpreamble

	AREA |TextureMap$$Code|, CODE, READONLY


	EXPORT c3d_inittexture
; r0 is screenbase
; r1 is workspace
c3d_inittexture
	stmfd r13!,{r4,r14}
	adrl r3,c3d_screenbase
	adrl r4,c3d_fogclut
	str r0,[r3]
	str r1,[r4]
	ldmfd r13!,{r4,pc}


	; pixel filling macro
	MACRO
	FILLER
	cmp r8,#8
	blt %f3	; less than 8 pixels, plot as individual pixels

	and r2,r7,#3
	rsb r2,r2,#3
	sub r8,r8,r2
1	; fill_loop_start
	mov r1,r9,asr #16
	add r1,r3,r1,asl r14
	ldrb r1,[r1,r10,asr #16]
	IF shade=1
	mov r4,r5,asr #16
	add r4,r0,r4,asl #8
	ldrb r1,[r4,r1]
	add r5,r5,r6
	ENDIF
	strb r1,[r7],#1
	add r9,r9,r11
	add r10,r10,r12
	subs r2,r2,#1
	bge %b1

	bic r7,r7,#3
	sub r8,r8,#4

2	; fill_loop
	mov r1,r9,asr #16	    ; repeated 4 times to fill a word
	add r1,r3,r1,asl r14
	ldrb r2,[r1,r10,asr #16]
	IF shade=1
	mov r4,r5,asr #16
	add r4,r0,r4,asl #8
	ldrb r2,[r4,r2]
	add r5,r5,r6
	ENDIF
	add r9,r9,r11
	add r10,r10,r12

	mov r1,r9,asr #16
	add r1,r3,r1,asl r14
	ldrb r1,[r1,r10,asr #16]
	IF shade=1
	mov r4,r5,asr #16
	add r4,r0,r4,asl #8
	ldrb r1,[r4,r1]
	add r5,r5,r6
	ENDIF
	orr r2,r2,r1,asl #8
	add r9,r9,r11
	add r10,r10,r12

	mov r1,r9,asr #16
	add r1,r3,r1,asl r14
	ldrb r1,[r1,r10,asr #16]
	IF shade=1
	mov r4,r5,asr #16
	add r4,r0,r4,asl #8
	ldrb r1,[r4,r1]
	add r5,r5,r6
	ENDIF
	orr r2,r2,r1,asl #16
	add r9,r9,r11
	add r10,r10,r12

	mov r1,r9,asr #16
	add r1,r3,r1,asl r14
	ldrb r1,[r1,r10,asr #16]
	IF shade=1
	mov r4,r5,asr #16
	add r4,r0,r4,asl #8
	ldrb r1,[r4,r1]
	add r5,r5,r6
	ENDIF
	orr r2,r2,r1,asl #24
	add r9,r9,r11
	add r10,r10,r12

	str r2,[r7],#4

	subs r8,r8,#4
	bgt %b2

	add r8,r8,#3

3	; jump_in_point

4	; fill_loop_end
	mov r1,r9,asr #16
	add r1,r3,r1,asl r14
	ldrb r1,[r1,r10,asr #16]
	IF shade=1
	mov r4,r5,asr #16
	add r4,r0,r4,asl #8
	ldrb r1,[r4,r1]
	add r5,r5,r6
	ENDIF
	strb r1,[r7],#1
	add r9,r9,r11
	add r10,r10,r12
	subs r8,r8,#1
	bge %b4		; fill_loop_end

	MEND


	EXPORT c3d_texture
c3d_texture
	GET C3Dlib:s.texturecore


	END
