

	AREA |fsqrt$$code|, CODE, READONLY

; algorithm from the comp.graphics.algorithms FAQ
	EXPORT c3d_fsqrt
c3d_fsqrt
	mov r1, #1<<30
	mov r2, #0

loop
	add r3, r1, r2
	mov r2, r2, asr #1
	cmp r3, r0
	suble r0, r0, r3
	orrle r2, r2, r1

	movs r1, r1, lsr #2
	bgt loop

	mov r0, r2

	movs pc, r14


; addvec - perform vector addition
; r0 *dest
; r1 *op1
; r2 *op2
	EXPORT c3d_addvec
c3d_addvec
	stmfd r13!,{r4-r8,r14}

	ldmia r1,{r3,r4,r5}
	ldmia r2,{r6,r7,r8}
	add r3,r3,r6
	add r4,r4,r7
	add r5,r5,r8
	stmia r0,{r3,r4,r5}

	ldmfd r13!,{r4-r8,pc}


; subvec - perform vector subtraction
	EXPORT c3d_subvec
c3d_subvec
	stmfd r13!,{r4-r8,r14}

	ldmia r1,{r3,r4,r5}
	ldmia r2,{r6,r7,r8}
	sub r3,r3,r6
	sub r4,r4,r7
	sub r5,r5,r8
	stmia r0,{r3,r4,r5}

	ldmfd r13!,{r4-r8,pc}


; dotprod - find the dot product of two vectors
; r0 - op1
; r1 - op2
	EXPORT c3d_dotprod8
c3d_dotprod8
	stmfd r13!,{r4-r7,r14}

	ldmia r0,{r2,r3,r4}
	ldmia r1,{r5,r6,r7}
	mul r0,r2,r5
	mla r0,r3,r6,r0
	mla r0,r4,r7,r0

	mov r0,r0,asr #8

	ldmfd r13!,{r4-r7,pc}

; dotprod - find the dot product of two vectors
; 12-bit fixed point version
; r0 - op1
; r1 - op2
	EXPORT c3d_dotprod12
c3d_dotprod12
	stmfd r13!,{r4-r7,r14}

	ldmia r0,{r2,r3,r4}
	ldmia r1,{r5,r6,r7}
	mul r0,r2,r5
	mla r0,r3,r6,r0
	mla r0,r4,r7,r0

	mov r0,r0,asr #12

	ldmfd r13!,{r4-r7,pc}


; crossprod - find the vector cross product of two vectors
; r0 - dest
; r1 - op1
; r2 - op2
	EXPORT c3d_crossprod8
c3d_crossprod8
	stmfd r13!,{r4-r9,r14}

	ldmia r1,{r3,r4,r5}
	ldmia r2,{r6,r7,r8}

	mul r1,r4,r8
	mul r2,r5,r7
	sub r1,r1,r2
	mov r1,r1,asr #8
	mul r2,r5,r6
	mul r9,r3,r8
	sub r2,r2,r9
	mov r2,r2,asr #8
	mul r9,r3,r7
	mul r3,r4,r6
	sub r3,r9,r3
	mov r3,r3,asr #8
	stmia r0,{r1,r2,r3}

	ldmfd r13!,{r4-r9,pc}


; crossprod - find the vector cross product of two vectors
; 12-bit fixed point version
; r0 - dest
; r1 - op1
; r2 - op2
	EXPORT c3d_crossprod12
c3d_crossprod12
	stmfd r13!,{r4-r9,r14}

	ldmia r1,{r3,r4,r5}
	ldmia r2,{r6,r7,r8}
	mul r1,r7,r5
	mul r2,r8,r4
	sub r1,r1,r2
	mov r1,r1,asr #12
	mul r2,r8,r3
	mul r9,r6,r5
	sub r2,r2,r9
	mov r2,r2,asr #12
	mul r9,r6,r4
	mul r3,r7,r3
	sub r9,r9,r3
	mov r3,r9,asr #12
	stmia r0,{r1,r2,r3}

	ldmfd r13!,{r4-r9,pc}


; r0 *dest
; r1 *src
; r2 *matrix
; r3 *offset
	EXPORT c3d_transformpt12
c3d_transformpt12
	stmfd r13!,{r4-r12,r14}
	ldmia r1,{r4-r6}
	ldmia r2!,{r7-r9}
	mul r10,r4,r7
	mul r11,r4,r8
	mul r12,r4,r9
	ldmia r2!,{r7-r9}
	mla r10,r5,r7,r10
	mla r11,r5,r8,r11
	mla r12,r5,r9,r12
	ldmia r2,{r7-r9}
	mla r10,r6,r7,r10
	mla r11,r6,r8,r11
	mla r12,r6,r9,r12
	cmp r3,#0
	beq no_translation
	ldmia r3,{r7-r9}
	add r10,r7,r10,asr #12
	add r11,r8,r11,asr #12
	add r12,r9,r12,asr #12
	stmia r0,{r10-r12}
	ldmfd r13!,{r4-r12,pc}

no_translation
	mov r10,r10,asr #12
	mov r11,r11,asr #12
	mov r12,r12,asr #12
	stmia r0,{r10-r12}
	ldmfd r13!,{r4-r12,pc}

; reverse transform a point, doing the offset first and using the transpose of the matrix
	EXPORT c3d_rtransformpt12
c3d_rtransformpt12
	stmfd r13!,{r4-r12,r14}
	ldmia r1,{r4-r6}
	ldmia r3,{r7-r9}	; offset
	sub r4,r4,r7
	sub r5,r5,r8
	sub r6,r6,r9
	ldmia r2!,{r7-r9}	; matrix col 0
	mul r10,r4,r7
	mla r10,r5,r8,r10
	mla r10,r6,r9,r10
	ldmia r2!,{r7-r9}	; matrix col 1
	mul r11,r4,r7
	mla r11,r5,r8,r11
	mla r11,r6,r9,r11
	ldmia r2,{r7-r9}	; matrix col 2
	mul r12,r4,r7
	mla r12,r5,r8,r12
	mla r12,r6,r9,r12
	mov r10,r10,asr #12
	mov r11,r11,asr #12
	mov r12,r12,asr #12
	stmia r0,{r10-r12}
	ldmfd r13!,{r4-r12,pc}


; sqrt(b12*b12+b12*b12+b12*b12) -> b6

	IMPORT __rt_sdiv

ACCURACY	EQU	6
ACCURACY2	EQU	1


	EXPORT c3d_normalize12
; r0 input matrix
c3d_normalize12
	stmfd r13!,{r4-r5,r14}

	ldmia r0,{r1,r2,r3}
	mov r4,r0
	mov r5,r1,asr #ACCURACY
	mul r0,r5,r5
	mov r5,r2,asr #ACCURACY
	mla r0,r5,r5,r0
	mov r5,r3,asr #ACCURACY
	mla r0,r5,r5,r0
	stmfd r13!,{r1-r3}
	bl c3d_fsqrt
	ldmfd r13!,{r1-r3}
	mov r5,r0

	mov r1,r1,asl #12-ACCURACY
	mov r0,r5
	stmfd r13!,{r2,r3}
	bl __rt_sdiv
	ldmfd r13!,{r2,r3}
	str r0,[r4,#0]

	mov r1,r2,asl #12-ACCURACY
	mov r0,r5
	stmfd r13!,{r2,r3}
	bl __rt_sdiv
	ldmfd r13!,{r2,r3}
	str r0,[r4,#4]

	mov r1,r3,asl #12-ACCURACY
	mov r0,r5
	stmfd r13!,{r2,r3}
	bl __rt_sdiv
	ldmfd r13!,{r2,r3}
	str r0,[r4,#8]

	ldmfd r13!,{r4-r5,pc}


	EXPORT c3d_normalize
c3d_normalize
	stmfd r13!,{r4-r5,r14}

	ldmia r0,{r1,r2,r3}
	mov r4,r0
	mov r5,r1,asr #ACCURACY2
	mul r0,r5,r5
	mov r5,r2,asr #ACCURACY2
	mla r0,r5,r5,r0
	mov r5,r3,asr #ACCURACY2
	mla r0,r5,r5,r0
	stmfd r13!,{r1-r3}
	bl c3d_fsqrt
	ldmfd r13!,{r1-r3}
	mov r5,r0

	mov r1,r1,asl #8-ACCURACY2
	mov r0,r5
	stmfd r13!,{r2,r3}
	bl __rt_sdiv
	ldmfd r13!,{r2,r3}
	str r0,[r4,#0]

	mov r1,r2,asl #8-ACCURACY2
	mov r0,r5
	stmfd r13!,{r2,r3}
	bl __rt_sdiv
	ldmfd r13!,{r2,r3}
	str r0,[r4,#4]

	mov r1,r3,asl #8-ACCURACY2
	mov r0,r5
	stmfd r13!,{r2,r3}
	bl __rt_sdiv
	ldmfd r13!,{r2,r3}
	str r0,[r4,#8]

	ldmfd r13!,{r4-r5,pc}


