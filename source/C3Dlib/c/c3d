#include <stdlib.h>
#include <stdio.h>

#include "allocv.h"
#include "c3d.h"
#include "bucket.h"

decor* c3d_gfxdata;

void c3d_initialise(char* datapath)
{
  int loop;
  char path[256];
  c3d_gfxdata = c_new(decor);
  c3d_gfxdata->textures = 0;
  c3d_gfxdata->patterns = 0;
  c3d_gfxdata->gouraudshades = 0;
  c3d_gfxdata->sprites = 0;
  c3d_gfxdata->cloud = 0;
  for (loop=0; loop<C3D_NUMTABLES; loop++)
  {
    c3d_gfxdata->tables[loop] = 0;
  }
  sprintf(path, "%ssintab", datapath);
  c3d_sintab = c3d_loadfile(path);
  sprintf(path, "%scostab", datapath);
  c3d_costab = c3d_loadfile(path);
}

void c3d_closedown(void)
{
  free(c3d_gfxdata);
  free(c3d_sintab);
  free(c3d_costab);
}
