#ifndef C3D_VBUF_H
#define C3D_VBUF_H 1

#include "primitive.h"
#include "bucket.h"

typedef struct {
  int type;          // 0 - direct   1 - sprite
  union
  {
    // XBitMap* whatever;  for X port?
//    sprite_area sprite;  for writing into sprites
    int* pixmap;
    int* screenbase;
  } buffer;
  struct {
    point global;
    int ambient;
    rgbcol fadecol;
  } light;
  int bank, numbanks, banksize, bitdepth;
  point2d size;
  point pos;
  matrix orient;
  bpolygon* polygonbuf;
  blist* listbuf;
  decor* dec;
  int refreshcounter;
} vbufinfo;

