	EXPORT m_XxY
m_XxY
; r0 screenbase
; r1 bitmap
; r2 *(x,y) top left
; r3 *(x,y) size
	stmfd r13!,{r4-r9,r14}
	ldmia r2,{r4,r5}
	ldmia r3,{r6,r7}
	orrs r8,r4,r5
	bmi mc_XxY
	add r8,r4,r6
	cmp r8,#320
	bge mc_XxY
	add r8,r5,r7
	cmp r8,#256
	bge mc_XxY

	add r0,r0,r5,lsl #8
	add r0,r0,r5,lsl #6
	add r0,r0,r4
	mov r4,r6
	mov r5,r7
yloop
	mov r6,r0
	mov r8,r4
xloop
	ldr r7,[r1],#4
	cmp r7,#0
	addeq r6,r6,#4
	beq miss4

	ands r9,r7,#255
	strneb r9,[r6]
	add r6,r6,#1

	mov r9,r7,lsr #8
	ands r9,r9,#255
	strneb r9,[r6]
	add r6,r6,#1

	mov r9,r7,lsr #16
	ands r9,r9,#255
	strneb r9,[r6]
	add r6,r6,#1

	mov r9,r7,lsr #24
	ands r9,r9,#255
	strneb r9,[r6]
	add r6,r6,#1
miss4
	subs r8,r8,#4
	bgt xloop

	add r0,r0,#320

	subs r5,r5,#1
	bgt yloop

	ldmfd r13!,{r4-r9,pc}^


	EXPORT mc_XxY
mc_XxY
; clipped version
	stmfd r13!,{r10-r12}

	sub r1,r1,#4

; clip to bottom
	cmp r5,#256
	bge offscreen3
	add r8,r5,r7
	cmp r8,#256
	rsbge r7,r5,#256

; clip to top
	cmn r5,r7
	ble offscreen3
	cmp r5,#0
	rsblt r5,r5,#0
	mlalt r1,r6,r5,r1
	sublt r7,r7,r5
	movlt r5,#0

	mov r12,#0	; lhs of displayed row
	mov r11,r6	; length of displayed row

; clip to right
	cmp r4,#320
	bge offscreen3
	add r8,r4,r6
	cmp r8,#316
	rsbge r11,r4,#316
	addge r11,r11,#3
	bicge r11,r11,#3

; clip to left
	cmn r4,r6
	ble offscreen3
	cmp r4,#0
	bge nolc2
	rsb r4,r4,#0
	add r12,r4,#4
	bic r12,r12,#3
	sub r11,r11,r12
	and r8,r4,#3
	eor r8,r8,#3
	add r0,r0,r8
	mov r4,#0
nolc2

	add r0,r0,r5,lsl #8
	add r0,r0,r5,lsl #6
	add r0,r0,r4

	mov r4,r6
	mov r5,r7

; initialise offset stuff
	and r2,r0,#3
	eor r2,r2,#3
	mov r2,r2,asl #3
	rsb r3,r2,#32
	bic r0,r0,#3
oyloop3
	mov r6,r0
	mov r8,r11	; row length
	stmfd r13!,{r1,r11,r12}
	add r1,r1,r12   ; r12 is row offset
	ldmia r1,{r9,r10,r11}
	add r1,r1,#12
oxloop3
	mov r9,r9,lsr r2
	orr r9,r9,r10,lsl r3
	mov r10,r10,lsr r2
	orr r10,r10,r11,lsl r3
	orrs r7,r9,r10	; don't want the result
	beq oskip83

	ldmia r6,{r7,r12}
	; it's not nice.
	tst r9,#&FF
	bicne r7,r7,#&FF
	tst r9,#&FF00
	bicne r7,r7,#&FF00
	tst r9,#&FF0000
	bicne r7,r7,#&FF0000
	tst r9,#&FF000000
	bicne r7,r7,#&FF000000
	tst r10,#&FF
	bicne r12,r12,#&FF
	tst r10,#&FF00
	bicne r12,r12,#&FF00
	tst r10,#&FF0000
	bicne r12,r12,#&FF0000
	tst r10,#&FF000000
	bicne r12,r12,#&FF000000
	orr r7,r7,r9
	orr r12,r12,r10
	stmia r6,{r7,r12}
oskip83
	add r6,r6,#8
	subs r8,r8,#8
	mov r9,r11
	ldmia r1!,{r10,r11}
	bgt oxloop3

	tst r8,#4
	bne norhscol2
	mov r9,r9,lsr r2
	orr r9,r9,r10,lsl r3
	ldr r7,[r6]
	tst r9,#&FF
	bicne r7,r7,#&FF
	tst r9,#&FF00
	bicne r7,r7,#&FF00
	tst r9,#&FF0000
	bicne r7,r7,#&FF0000
	tst r9,#&FF000000
	bicne r7,r7,#&FF000000
	orr r7,r7,r9
	str r7,[r6]
norhscol2

	ldmfd r13!,{r1,r11,r12}
	add r1,r1,r4	; next row

	add r0,r0,#320

	subs r5,r5,#1
	bgt oyloop3

offscreen3

	ldmfd r13!,{r10-r12}
	ldmfd r13!,{r4-r9,pc}^


