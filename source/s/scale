	AREA |C$$code|, CODE, READONLY

	IMPORT __rt_sdiv

; very non-optimal masked scale routine
	EXPORT sm_64x64
sm_64x64
; r0 screenbase
; r1 bitmap
; r2 *(x,y) position
; r3 65536/scale factor
	stmfd r13!,{r4-r7,r14}
	stmfd r13!,{r0-r3}
	mov r1,#64*65536
	mov r0,r3
	bl __rt_sdiv
	mov r6,r0
	ldmfd r13!,{r0-r3}
	ldmia r2,{r4,r5}
	; test for edges
	cmp r4,#0
	blt smc_64x64
	cmp r5,#0
	blt smc_64x64
	add r7,r4,r6
	cmp r7,#320
	bge smc_64x64
	add r7,r5,r6
	cmp r7,#256
	bge smc_64x64
	; done testing edges, draw scaled thing
	add r0,r0,r5,lsl #8
	add r0,r0,r5,lsl #6
	add r0,r0,r4
	mov r5,#0
rowloop
	mov r7,r0
	mov r4,#0
colloop
	mov r6,r5,asr #16
	add r6,r1,r6,lsl #6
	ldrb r6,[r6,r4,asr #16]
	add r4,r4,r3
	cmp r6,#0
	strneb r6,[r7]
	add r7,r7,#1
	cmp r4,#64*65536
	blt colloop

	add r0,r0,#320
	add r5,r5,r3
	cmp r5,#64*65536
	blt rowloop

	ldmfd r13!,{r4-r7,pc}^


	EXPORT smc_64x64
smc_64x64
; r0 screenbase
; r1 bitmap
; r2 *(x,y) position
; r3 65536/scale factor
; clipped version
	stmfd r13!,{r8-r12}

	mov r8,r6	; r8 = x limit
	mov r9,r6	; r9 = y limit

	; r4 x pos
	; r5 y pos
	; r6 x,y size
	cmn r5,r9
	ble offscreen1
	cmp r5,#0
	rsblt r5,r5,#0
	mullt r11,r3,r5
	sublt r9,r9,r5
	movlt r5,#0
	movge r11,#0

	cmp r5,#256
	bge offscreen1
	add r6,r5,r9
	cmp r6,#256
	blt highenough
	sub r6,r5,#256
	rsbs r9,r6,#0
	blt offscreen1
highenough

	cmn r4,r8
	ble offscreen1
	cmp r4,#0
	rsblt r4,r4,#0
	mullt r10,r3,r4
	sublt r8,r8,r4
	movlt r4,#0
	movge r10,#0	; r10=sprite x-start

	cmp r4,#320
	bge offscreen1
	add r6,r4,r8
	cmp r6,#320
	blt leftenough
	sub r6,r4,#320
	rsbs r8,r6,#0
	blt offscreen1
leftenough

	add r0,r0,r5,lsl #8
	add r0,r0,r5,lsl #6
	add r0,r0,r4
	mov r5,r11
rowloop3
	mov r7,r0
	mov r12,r8	; width
	mov r4,r10
colloop3
	mov r6,r5,asr #16
	add r6,r1,r6,lsl #6
	ldrb r6,[r6,r4,asr #16]
	add r4,r4,r3
	cmp r6,#0
	strneb r6,[r7]
	add r7,r7,#1
	subs r12,r12,#1
	bgt colloop3

	add r0,r0,#320
	add r5,r5,r3
	subs r9,r9,#1
	bgt rowloop3

offscreen1
	ldmfd r13!,{r8-r12}
	ldmfd r13!,{r4-r7,pc}^

