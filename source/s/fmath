	AREA |C$$code|, CODE, READONLY

; algorithm from the comp.graphics.algorithms FAQ
	EXPORT fsqrt
fsqrt
	mov r1, #1<<30
	mov r2, #0

loop
	add r3, r1, r2
	mov r2, r2, asr #1
	cmp r3, r0
	suble r0, r0, r3
	orrle r2, r2, r1

	movs r1, r1, lsr #2
	bgt loop

	mov r0, r2

	movs pc, r14


	END
