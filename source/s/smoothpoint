	AREA |C$$data|

; grey scale in the standard 256 colour palette
greytab
	DCB 0
	DCB 1
	DCB 2
	DCB 3
	DCB 44
	DCB 45
	DCB 46
	DCB 47
	DCB 208
	DCB 209
	DCB 210
	DCB 211
	DCB 252
	DCB 253
	DCB 254
	DCB 255

	IMPORT cuberoottab
	IMPORT smoothpttab

	AREA |C$$code|, CODE, READONLY

	EXPORT smoothpoint
smoothpoint
; r0 screenbase
; r1 x position (16x pixel)
; r2 y position (16x pixel)
; r3 intensity
	stmfd r13!,{r4-r11,r14}
	and r4,r1,#15
	and r5,r2,#15
	movs r1,r1,asr #4
	blt offscreen
	movs r2,r2,asr #4
	blt offscreen
	mov r6,#320
	sub r6,r6,#2
	cmp r1,r6
	bge offscreen
	cmp r2,#254
	bge offscreen
	rsb r6,r4,#15
	rsb r7,r5,#15
	adrl r8,cuberoottab
	adrl r10,greytab
;	ldr r8,[r8]
	; first corner
	mul r9,r6,r7
	ldrb r9,[r8,r9]
	mul r9,r3,r9
	ldrb r9,[r10,r9,lsr #12]
	add r11,r0,r2,lsl #8
	add r11,r11,r2,lsl #6
	strb r9,[r11,r1]!
	; second corner
	mul r9,r4,r7
	ldrb r9,[r8,r9]
	mul r9,r3,r9
	ldrb r9,[r10,r9,lsr #12]
	strb r9,[r11,#1]
	; third corner
	mul r9,r6,r5
	ldrb r9,[r8,r9]
	mul r9,r3,r9
	ldrb r9,[r10,r9,lsr #12]
	strb r9,[r11,#320]
	; fourth corner
	mul r9,r4,r5
	ldrb r9,[r8,r9]
	mul r9,r3,r9
	ldrb r9,[r10,r9,lsr #12]
	strb r9,[r11,#321]
offscreen
	ldmfd r13!,{r4-r11,pc}^


	EXPORT smoothpoint2
smoothpoint2
; this one uses fewer multiplies, should be faster on older hardware
; r0 screenbase
; r1 x pos
; r2 y pos
; r3 intensity
	stmfd r13!,{r4-r7,r14}
	mov r4,r1,asr #4
	mov r5,#320
	sub r5,r5,#2
	cmp r4,r5
	bhs offscreen2
	mov r5,r2,asr #4
	cmp r5,#254
	bhs offscreen2

	add r0,r0,r5,asl #8
	add r0,r0,r5,asl #6
	add r0,r0,r4

	and r4,r1,#15
	and r5,r2,#15

	adrl r6,smoothpttab
	adrl r7,greytab
	add r5,r4,r5,lsl #4
	ldr r4,[r6,r5,lsl #2]

	and r6,r4,#255
	mul r6,r3,r6
	ldrb r6,[r7,r6,asr #12]
	strb r6,[r0]

	mov r4,r4,lsr #8
	and r6,r4,#255
	mul r6,r3,r6
	ldrb r6,[r7,r6,asr #12]
	strb r6,[r0,#1]

	mov r4,r4,lsr #8
	and r6,r4,#255
	mul r6,r3,r6
	ldrb r6,[r7,r6,asr #12]
	strb r6,[r0,#320]

	mov r4,r4,lsr #8
	and r6,r4,#255
	mul r6,r3,r6
	ldrb r6,[r7,r6,asr #12]
	strb r6,[r0,#321]

offscreen2
	ldmfd r13!,{r4-r7,pc}^


	EXPORT blob
blob
; r0 screenbase
; r1 x
; r2 y
; r3 colour
	add r0,r0,r2,lsl #8
	add r0,r0,r2,lsl #6
	add r0,r0,r1
	strb r3,[r0]
	strb r3,[r0,#1]
	strb r3,[r0,#320]
	strb r3,[r0,#321]
	movs pc,r14

	END
