; Little bit of macro from SWINames.h
Auto_Error_SWI_bit_number * 17
Auto_Error_SWI_bit * 1 :SHL: Auto_Error_SWI_bit_number

        GBLS    SWIClass
        MACRO
        AddSWI  $SWIName,$value
  [     "$value" = ""
$SWIClass._$SWIName # 1
  |
$SWIClass._$SWIName * $value
  ]
X$SWIClass._$SWIName * $SWIClass._$SWIName + Auto_Error_SWI_bit
        MEND


SWIClass SETS	"FlexiSound"
	^	&4E0C0
	AddSWI	Add
	AddSWI	Remove
	AddSWI	Play
	AddSWI	ReturnInfo
	AddSWI	SaveOpen
	AddSWI	LoadOpen
	AddSWI	LinToLog
	AddSWI	PlayFromDisc
	AddSWI	PlayFromRAM
	AddSWI	Stop
	AddSWI	ReadTimer1

	AREA |fsndcode$$code|, CODE, READONLY

	EXPORT flexisound_add
	EXPORT flexisound_remove
	EXPORT flexisound_play
	EXPORT readtimer1

flexisound_add
	swi FlexiSound_Add
	movs pc,r14

flexisound_remove
	swi FlexiSound_Remove
	movs pc,r14

flexisound_play
	swi FlexiSound_Play
	movs pc,r14

readtimer1
	swi FlexiSound_ReadTimer1
	movs pc,r14

	END
