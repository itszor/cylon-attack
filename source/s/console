	AREA |C$$code|, CODE, READONLY

	EXPORT plotconsole
plotconsole
; r0 screenbase
; r1 console data (horizontal spans of {start addr, end addr, data} items)
	stmfd r13!,{r4-r12,r14}
spanloop
	ldmia r1!,{r2,r3}
	sub r3,r3,r2
	add r2,r2,r0
fillspan
	ldr r4,[r1],#4
	subs r3,r3,#4
	str r4,[r2],#4
	bgt fillspan

	sub r2,r2,r0
	cmp r2,#81920
	blt spanloop

	ldmfd r13!,{r4-r12,pc}

	END
