void updatestatus(void)
{
  gameinfo* game = global_game;
  int max;

  updateenemies(game);

  if (game->state!=gamestate_READYTODOCK && game->state!=gamestate_LAUNCH)
    controls(game);

  if (game->powerup==powerup_JELLY)
  {
    game->pos.x += game->speed.x+((game->amp.x*c3d_sini12(game->phase.x))>>13);
    game->pos.y += game->speed.y+((game->amp.y*c3d_sini12(game->phase.y))>>13);
  }
  else
  {
    game->pos.x += game->speed.x;
    game->pos.y += game->speed.y;
  }

  max = abs(game->speed.x) + abs(game->speed.y);

  // re-pitch wobbly sound (bit 7 of volume set means the sample isn't restarted)
  flexisound_play(game->sound.wobble, 4, 0x1df, 0x1000+max*2);

  game->scene->offset.x = game->pos.x >> 2;
  game->scene->offset.y = game->pos.y >> 2;

  if (game->state == gamestate_FIRING)
  {
    game->shotdepth += 3072;
    if (game->shotdepth > 262144) testcollision(game);
  }

  if (!game->enemies) game->state = gamestate_LEVELDONE;

  if (!(rand()&4095))
  {
    enemyinfo* enemy;
    c3d_list_add(&game->enemies);
    enemy = game->enemies->data = (void*) newenemy(enemytype_POWERUP);
    enemy->distance = 65536;
    qrand(enemy->speed.x, 48);
    qrand(enemy->speed.y, 48);
    enemy->energy = 0;
    enemy->statecounter = 333;
    enemy->whiteout = 10;  // flash on appearance
    enemy->subclass = rand()&3;
  }

  game->ticker++;
  if (game->explostate>0) game->explostate--;
  game->fuel-=4;
  game->laser += (game->lasertype==1) ? 48 : 32;
  if (game->laser > 65535) game->laser = 65535;
  if (game->fuel <= 0) game->state = gamestate_DIED;
  if (game->messagetimer) game->messagetimer--;
  if (game->poweruptimer && !--game->poweruptimer)
  {
    game->powerup = powerup_NONE;
    message(game, "NORMAL");
  }
}
