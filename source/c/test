void tidysound(void)
{
  if (global_soundinfo)
  {
    flexisound_remove(global_soundinfo->launch);
    flexisound_remove(global_soundinfo->dock);
    flexisound_remove(global_soundinfo->bombed);
    flexisound_remove(global_soundinfo->deflect);
    flexisound_remove(global_soundinfo->wobble);
    flexisound_remove(global_soundinfo->laser);
    flexisound_remove(global_soundinfo->explosion);
    flexisound_remove(global_soundinfo->dud);
  }

#ifdef PREEMPTIVE_UPDATE
  if (preempt_running) freeglue();
#endif
}

int* loadandconvertsprites(char* pathname, int bytesize, int num)
{
  int *spr1, *sprdat, *dest, *temp, i;

  dest = malloc(bytesize*num);
  temp = c3d_loadfile(pathname);
  spr1 = (int*)((int)temp+temp[1]-4);

  for (i=0; i<num; i++)
  {
    sprdat = (int*)((int)spr1+spr1[8]);
    memcpy(&dest[i*bytesize/4], sprdat, bytesize);
    spr1 = (int*)((int)spr1+spr1[0]);
  }

  free(temp);

  return dest;
}

void loadandconvertvsprites(char* pathname, const point2d sizes[], int *bases[], int num)
{
  int *spr1, *sprdat, *temp, i, bytesize;

  temp = c3d_loadfile(pathname);
  spr1 = (int*)((int)temp+temp[1]-4);

  for (i=0; i<num; i++)
  {
    bytesize = sizes[i].x*sizes[i].y;
    bases[i] = malloc(bytesize);
    sprdat = (int*)((int)spr1+spr1[8]);
    memcpy(bases[i], sprdat, bytesize);
    spr1 = (int*)((int)spr1+spr1[0]);
  }

  free(temp);
}

