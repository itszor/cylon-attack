#include <stdlib.h>

#include "allocv.h"
#include "game.h"
#include "enemy.h"
#include "levels.h"

// the level progression isn't particularly exciting.
// wish I had some imagination sometimes...
void initlevel(gameinfo* game)
{
  int i, t;
  int num[] = {0,0,0,0,0};
  enemytype tp[] = {enemytype_SKULL,
                    enemytype_FIGHTER,
                    enemytype_SAUCER,
                    enemytype_SHELL,
                    enemytype_SNAKE};
  enemyinfo* enemy;
  int toughness = game->level/6;

  num[0] = (game->level+2)-toughness*2;
  num[1] = (game->level+1)-toughness*2;
  num[2] = (game->level-1)-toughness*2;
  num[3] = (game->level-2)-toughness*2;
  num[4] = ((game->level-3)/2)-toughness*2;

  for (i=0; i<5; i++) if (num[i]<0) num[i]=0;

  for (t=0; t<5; t++)
  {
    for (i=0; i<num[t]; i++)
    {
      c3d_list_add(&game->enemies);
      game->enemies->data = (void*) newenemy(tp[t]);
    }
    game->enemyshield[tp[t]] = toughness;
  }

/*  game->enemyshield[enemytype_SKULL]=1;
  game->enemyshield[enemytype_FIGHTER]=2;*/

  c3d_list_add(&game->enemies);
  enemy = game->enemies->data = (void*) newenemy(enemytype_MOTHERSHIP);

  enemy->mode = enemymode_IDLE;
  enemy->energy = 255;   // shield == energy for mothership
  enemy->distance = 131072;

/*  c3d_list_add(&game->enemies);
  enemy = game->enemies->data = (void*) newenemy(enemytype_SNAKE);*/
/*  c3d_list_add(&game->enemies);
  enemy = game->enemies->data = (void*) newenemy(enemytype_POWERUP);*/
}

// frees up memory used by the bad things
void tidylevel(gameinfo* game)
{
  list* e = game->enemies;

  while (e)
  {
    deleteenemy((enemyinfo*)e->data);
    c3d_list_removehead(&e);
  }

  // shouldn't be necessary?
  game->enemies = 0;
}
