#include <math.h>
#include "smoothpoint.h"

char cuberoottab[256];
unsigned int smoothpttab[16][16];

void smoothptinit(void)
{
  int i, j;

  cuberoottab[0] = 0;

  for (i=1; i<256; i++)
    cuberoottab[i] = (char)(40.3701074*pow((double)i, 1./3.));

  for (j=0; j<16; j++)
  {
    int ji=15-j;
    for (i=0; i<16; i++)
    {
      int ii=15-i;
      int p0 = cuberoottab[ii*ji];
      int p1 = cuberoottab[i*ji];
      int p2 = cuberoottab[ii*j];
      int p3 = cuberoottab[i*j];
      smoothpttab[j][i] = p0 | (p1<<8) | (p2<<16) | (p3<<24);
    }
  }
}
