int bomb_idle(void* game_p, void* enemy_p)
{
  gameinfo* game = (gameinfo*) game_p;
  enemyinfo* enemy = (enemyinfo*) enemy_p;
  point2d pos;

  if (enemy->statecounter==0)
  {
    if (toscreen(game->scene, &pos, &enemy->pos))
    {
      int i;
//            point2d pos;
//            pos.x = (16384-game->scene->offset.x)&32767;
//            pos.y = (16384-game->scene->offset.y)&32767;
//            toscreen(game->scene, &pos, &pos);
      if (game->powerup!=powerup_INVINCIBLE) game->shield -= enemy->energy;
      game->explostate = 50;
      for (i=(rand()&3)+1; i>=0; i--)
      {
        enemyinfo* explo;
        // Make an explosion
        c3d_list_add(&game->enemies);
        explo = game->enemies->data = (void*) newenemy(enemytype_EXPLOSION);
        explo->mode = enemymode_IDLE;
        qrand(explo->speed.x, 32);
        qrand(explo->speed.y, 32);
        explo->pos = enemy->pos;
        explo->statecounter = 49*16-(rand()&63);
        explo->distance = 65536;
        _swix(Sound_Stereo, _INR(0,1), 3, 0);
        flexisound_play(game->sound.bombed, 3, 0x17f, 0x1800);
      }
    }
    if (game->shield <= 0) game->state = gamestate_DIED;
    return 0;
  } else enemy->statecounter--;
  return 1;
}

int powerup_idle(void* game_p, void* enemy_p)
{
  enemyinfo* enemy = (enemyinfo*) enemy_p;

  if (enemy->statecounter==0)
  {
    qrand(enemy->speed.x, 48);
    qrand(enemy->speed.y, 48);
    enemy->statecounter = 333;
  } else enemy->statecounter--;

  if (enemy->energy>990) enemy->whiteout = 10; // no display routine I don't think

  return enemy->energy<1000;  // disappear after 10 secs
}

int mothership_idle(void* game_p, void* enemy_p)
{
  gameinfo* game = (gameinfo*) game_p;
  enemyinfo* enemy = (enemyinfo*) enemy_p;
  point2d pos;
  pos.x = (16384-game->scene->offset.x)&32767;
  pos.y = (16384-game->scene->offset.y)&32767;
  if (toscreen(game->scene, &pos, &pos) && atcentreof(game, enemy, &pos))
  {
    if (enemy->distance > 32768)
    {
      enemy->distance -= 256;
/*      enemy->speed.x = 0;
      enemy->speed.y = 0;*/
    }
    else
    {
      if (properenemies(game->enemies)==0)
        game->state = gamestate_FINALAPPROACH;
      else
        game->state = gamestate_REFUELDOCK;
    }
  }
  else if (enemy->distance < 131072) enemy->distance += 256;

  randomwalk(enemy, 25, 100, 4, 8);

  return 1;
}
