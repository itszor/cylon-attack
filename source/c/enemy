void randomwalk(enemyinfo* enemy, int shortest, int range, int delta, int bound)
{
  if (enemy->statecounter==0)
  {
    enemy->statecounter = shortest+rand()%range;
    arand(enemy->speed.x, delta);
    arand(enemy->speed.y, delta);
    if (enemy->speed.x>bound) enemy->speed.x=bound;
    if (enemy->speed.x<-bound) enemy->speed.x=-bound;
    if (enemy->speed.y>bound) enemy->speed.y=bound;
    if (enemy->speed.y<-bound) enemy->speed.y=-bound;
  }
  else enemy->statecounter--;
}

void checkretreat(gameinfo* game, enemyinfo* enemy)
{
  point2d pos;
  if (!(toscreen(game->scene, &pos, &enemy->pos) && rand()&255))
  {
    enemy->mode = enemymode_RETREAT;
    enemy->distance = 65536;
    qrand(enemy->speed.x, 64);
    qrand(enemy->speed.y, 64);
  }
}

int snake_idle(void* game_p, void* enemy_p)
{
  gameinfo* game = (gameinfo*) game_p;
  enemyinfo* enemy = (enemyinfo*) enemy_p;
  snakeinfo* snake = (snakeinfo*) enemy->extra;
  extern int* c3d_sintab, *c3d_costab;
  point2d pos;

  if (snake->length<snake->maxlen) snake->length++;

  snake->ptr++;
  if (snake->ptr>=TRAILLEN) snake->ptr = 0;

  snake->trail[snake->ptr] = enemy->pos;

  if (!(rand()&255)) qrand(snake->angled, CURVINESS);

  snake->angle = (snake->angle+snake->angled)&1023;
  enemy->pos.x += c3d_sintab[snake->angle]>>8;
  enemy->pos.y += c3d_costab[snake->angle]>>8;
  enemy->distance = 131072;

  if (toscreen(game->scene, &pos, &enemy->pos) && !(rand()&511))
  {
    if (snake->maxlen>SEGLENGTH)  // break off tail
    {
      int index = snake->ptr-(snake->length-SEGLENGTH);
      enemyinfo* attacker;
      if (index<0) index+=TRAILLEN;
      snake->length -= SEGLENGTH;
      snake->maxlen -= SEGLENGTH;
      c3d_list_add(&game->enemies);
      attacker = game->enemies->data = (void*) newenemy(enemytype_SNAKE_A);
      attacker->pos = snake->trail[index];
      qrand(attacker->speed.x, 8);
      qrand(attacker->speed.y, 8);
      attacker->distance = 131072;
      attacker->mode = enemymode_APPROACH;
    }
    else   // last piece attacks
    {
      enemy->type = enemytype_SNAKE_A;
      qrand(enemy->speed.x, 8);
      qrand(enemy->speed.y, 8);
      enemy->distance = 131072;
      enemy->mode = enemymode_APPROACH;
    }
  }

  return 1;
}

int snake_approach(void* game_p, void* enemy_p)
{
  gameinfo* game = (gameinfo*) game_p;
  enemyinfo* enemy = (enemyinfo*) enemy_p;
  point2d pos;
  if (toscreen(game->scene, &pos, &enemy->pos))
  {
    enemy->distance -= 256;
    if (enemy->distance < 65536)
    {
      enemy->distance = 65536;
      enemy->mode = enemymode_ATTACK;
      enemy->energy = rand()&127;
      enemy->statecounter = 50;
      enemy->speed.x = (2560-pos.x)/50;
      enemy->speed.y = (2048-pos.y)/50;
    }
  }
  else
  {
    enemy->distance -= 256;
    if (enemy->distance < 65536)
    {
      enemy->distance = 65536;
      enemy->mode = enemymode_ATTACK;
      enemy->statecounter = 50;
      qrand(enemy->speed.x, 16);
      qrand(enemy->speed.y, 16);
    }
  }
  return 1;
}

int snake_attack(void* game_p, void* enemy_p)
{
  gameinfo* game = (gameinfo*) game_p;
  enemyinfo* enemy = (enemyinfo*) enemy_p;
  enemyinfo* bomb;
  int i;

  if (enemy->energy>140) enemy->whiteout = 10;

  if (enemy->energy>150)
  {
    for (i=0; i<4; i++)
    {
      c3d_list_add(&game->enemies);
      bomb = game->enemies->data = (void*) newenemy(enemytype_BOMB2);
      bomb->pos = enemy->pos;
      qrand(bomb->speed.x, 16);
      qrand(bomb->speed.y, 16);
      bomb->statecounter = game->fuse2;
      bomb->distance = 65536;
      bomb->energy = 2048;    // not very lethal
    }
    return 0;
  }
  return 1;
}

int explosion_idle(void* game_p, void* enemy_p)
{
