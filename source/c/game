gameinfo* newgame(void)
{
  gameinfo* game = c_new(gameinfo);
  int i;

  game->scene = newscene();

  resetgame(game);
/*
  for (i=0; i<16; i++)
  {
    c3d_list_add(&game->enemies);
    game->enemies->data = (void*) newenemy((enemytype)rand()&3);
  }

*/

  for (i=0; i<ENEMYTYPES; i++)
  {
    game->enemyshield[i] = 0;
    switch (i)
    {
      case enemytype_SKULL:
      case enemytype_FIGHTER:
      case enemytype_SNAKE:   // some redundancy here
      case enemytype_SNAKE_A:
      case enemytype_SAUCER:
      case enemytype_SHELL:
      {
        game->enemyctrl[i][enemymode_IDLE] = default_idle;
        game->enemyctrl[i][enemymode_APPROACH] = default_approach;
        game->enemyctrl[i][enemymode_RETREAT] = default_retreat;
      }
      break;

      case enemytype_MOTHERSHIP:
      {
        game->enemyctrl[i][enemymode_IDLE] = mothership_idle;
        game->enemyctrl[i][enemymode_APPROACH] = 0;
        game->enemyctrl[i][enemymode_ATTACK] = 0;
        game->enemyctrl[i][enemymode_RETREAT] = 0;
      }
      break;

      case enemytype_BOMB1:
      case enemytype_BOMB2:
      case enemytype_POWERUP:
      {
        game->enemyctrl[i][enemymode_IDLE] = bomb_idle;
        game->enemyctrl[i][enemymode_APPROACH] = 0;
        game->enemyctrl[i][enemymode_ATTACK] = 0;
        game->enemyctrl[i][enemymode_RETREAT] = 0;
      }
      break;

      case enemytype_EXPLOSION:
      {
        game->enemyctrl[i][enemymode_IDLE] = explosion_idle;
        game->enemyctrl[i][enemymode_APPROACH] = 0;
        game->enemyctrl[i][enemymode_ATTACK] = 0;
        game->enemyctrl[i][enemymode_RETREAT] = 0;
      }
      break;
    }
  }

  game->enemyctrl[enemytype_POWERUP][enemymode_IDLE] = powerup_idle;
  game->enemyctrl[enemytype_SNAKE][enemymode_IDLE] = snake_idle;
  game->enemyctrl[enemytype_SNAKE_A][enemymode_APPROACH] = snake_approach;

  game->enemyctrl[enemytype_SKULL][enemymode_ATTACK] = skullfighter_attack;
  game->enemyctrl[enemytype_FIGHTER][enemymode_ATTACK] = skullfighter_attack;
  game->enemyctrl[enemytype_SAUCER][enemymode_ATTACK] = saucer_attack;
  game->enemyctrl[enemytype_SHELL][enemymode_ATTACK] = shell_attack;
  game->enemyctrl[enemytype_SNAKE][enemymode_ATTACK] = 0;
  game->enemyctrl[enemytype_SNAKE_A][enemymode_ATTACK] = snake_attack;

  for (i=0; i<24; i++)
  {
    game->hiscores[i].score = 0;
    strncpy(game->hiscores[i].initials, "JTB", 3);
  }

  return game;
}

void resetgame(gameinfo* game)
{
  game->lives = 3;
  game->fuelcells = 3;
  game->fuel = 65535;
  game->shield = 65535;
  game->msshield = 65535;
  game->laser = 65535;
  game->lasertype = 0;
  game->pos.x = game->pos.y = 0;
  game->speed.x = game->speed.y = 0;
  game->amp.x = game->amp.y = 0;
  game->phase.x = game->phase.y = 0;
  game->state = gamestate_LAUNCH;
  game->explostate = 0;
  game->powerup = powerup_NONE;
  game->poweruptimer = 0;
  game->fuse1 = 200;
  game->fuse2 = 150;
  game->level = 0;
  game->ticker = 0;
  game->enemies = 0;
  game->score = 0;
  game->flashmessage = "NO MESSAGE";
  game->messagetimer = 0;
}

void plotxhair(gameinfo* game, int count)
{
  point2d pos = {136,112};
  point2d centre = {2560,2048};
  const point2d xhairsize = {48,32};
  int n=0;
  list* e;

  if (count)
  {
    for (e=game->enemies; e; e=e->prev)
      if (intersect(game, (enemyinfo*)e->data, &centre)) n++;

    if (n>3) n=3;
  }

  // plot crosshair
  m_XxY(game->scene->buffer, &game->scene->bitmaps.xhair[n*48*32/4], &pos, &xhairsize);
}

