// This file is no longer used.

#include "swis.h"

#include "game.h"
#include "sound.h"

void setsample(gameinfo* game, int channel, int* start, int* end, int pitch)
{
  _swi(DataVox_SetMemory, _INR(0,2), game->sample.channels[0],
       game->sample.wobble+1, game->sample.wobble+wobblesize+1);
  _swi(DataVox_Timed, _INR(0,1), game->sample.channels[0], 1);
  _swi(DataVox_SetRepeat, _INR(0,2), game->sample.channels[0],
       game->sample.wobble+1, game->sample.wobble+wobblesize+1);
  _swi(DataVox_Pitch, _INR(0,1), game->sample.channels[0], 1000);
}
