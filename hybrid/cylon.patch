+++ b/test.c	2026-10-21 10:07:38.630612499 +0100
@@ -72,13 +72,13 @@
 
   dest = malloc(bytesize*num);
   temp = c3d_loadfile(pathname);
-  spr1 = (int*)((int)temp+temp[1]-4);
+  spr1 = (int*)((intptr_t)temp+temp[1]-4);
 
   for (i=0; i<num; i++)
   {
-    sprdat = (int*)((int)spr1+spr1[8]);
+    sprdat = (int*)((intptr_t)spr1+spr1[8]);
     memcpy(&dest[i*bytesize/4], sprdat, bytesize);
-    spr1 = (int*)((int)spr1+spr1[0]);
+    spr1 = (int*)((intptr_t)spr1+spr1[0]);
   }
 
   free(temp);
@@ -91,15 +91,15 @@
   int *spr1, *sprdat, *temp, i, bytesize;
 
   temp = c3d_loadfile(pathname);
-  spr1 = (int*)((int)temp+temp[1]-4);
+  spr1 = (int*)((intptr_t)temp+temp[1]-4);
 
   for (i=0; i<num; i++)
   {
     bytesize = sizes[i].x*sizes[i].y;
     bases[i] = malloc(bytesize);
-    sprdat = (int*)((int)spr1+spr1[8]);
+    sprdat = (int*)((intptr_t)spr1+spr1[8]);
     memcpy(bases[i], sprdat, bytesize);
-    spr1 = (int*)((int)spr1+spr1[0]);
+    spr1 = (int*)((intptr_t)spr1+spr1[0]);
   }
 
